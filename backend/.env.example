# Copy to .env.production on the production host.
# Never commit real credentials.

NODE_ENV=production
PORT=3001
HOST=127.0.0.1

DB_NAME=database_production
DB_USER=iot_app
DB_PASS=replace_with_a_strong_random_password
DB_HOST=127.0.0.1

JWT_SECRET=replace_with_a_cryptographically_random_secret

# 32-byte AES key encoded as 64 hexadecimal characters.
# Used only for protected camera connection data.
CAMERA_SOURCE_KEY=replace_with_64_hex_characters

# MediaMTX Control API. Keep this on loopback only.
MEDIA_GATEWAY_API_URL=http://127.0.0.1:9997
