[Unit]
Description=IoT Manager Media Gateway
Documentation=https://mediamtx.org/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=iot-media
Group=iot-media

EnvironmentFile=-/etc/iot-manager/mediamtx.env

ExecStart=/usr/local/bin/mediamtx /etc/iot-manager/mediamtx.yml

Restart=on-failure
RestartSec=3s

TimeoutStartSec=20s
TimeoutStopSec=20s

LimitNOFILE=65536
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true

ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
